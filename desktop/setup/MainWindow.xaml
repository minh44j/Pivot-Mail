<Window x:Class="PivotMailSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pivot Mail Setup" Width="752" Height="472"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <!-- 16 px around the card leave room for its soft shadow -->
  <Border x:Name="Card" Margin="16" CornerRadius="18" BorderBrush="#1A0F1F35" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#FCFDFF" Offset="0" />
        <GradientStop Color="#F3F6FB" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.16" Color="#0F1F35" /></Border.Effect>

    <Grid x:Name="Root">
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- soft waves along the bottom: blue on the left, mint on the right -->
      <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
        <Path Canvas.Left="0" Canvas.Top="250" Data="M0,40 C120,30 240,160 420,160 L0,160 Z" Width="720">
          <Path.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#A9C8F5" Offset="0" />
              <GradientStop Color="#00A9C8F5" Offset="1" />
            </LinearGradientBrush>
          </Path.Fill>
          <Path.Opacity>0.55</Path.Opacity>
          <Path.Effect><BlurEffect Radius="6" /></Path.Effect>
        </Path>
        <Path Canvas.Left="0" Canvas.Top="250" Data="M260,160 C430,160 560,70 720,0 L720,160 Z">
          <Path.Fill>
            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
              <GradientStop Color="#A8E3D3" Offset="0" />
              <GradientStop Color="#00A8E3D3" Offset="1" />
            </LinearGradientBrush>
          </Path.Fill>
          <Path.Opacity>0.6</Path.Opacity>
          <Path.Effect><BlurEffect Radius="6" /></Path.Effect>
        </Path>
      </Canvas>

      <!-- title bar -->
      <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="OnDrag">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <Image Source="pack://application:,,,/icon.png" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Pivot Mail Setup" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
          <Button x:Name="MinBtn" Style="{StaticResource Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimise" />
          <Button x:Name="CloseBtn" Style="{StaticResource Caption}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
        </StackPanel>
        <Border Height="1" VerticalAlignment="Bottom" Background="#E6EBF2" />
      </Grid>

      <!-- 1. welcome -->
      <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12">
        <Image Source="pack://application:,,,/icon.png" Width="58" Height="58" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,14">
          <Image.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.25" /></Image.Effect>
        </Image>
        <TextBlock Text="Install Pivot Mail" FontFamily="{StaticResource Display}" FontSize="38" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
        <TextBlock Text="A secure, fast and simple mail app for your team." FontSize="16" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" Margin="0,8,0,26" />
        <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="Install" IsDefault="True" Click="OnInstall" />
        <Button Style="{StaticResource Secondary}" Content="Quit" Margin="0,12,0,0" Click="OnClose" />
        <TextBlock x:Name="Fine" FontSize="11.5" Foreground="#8A94A3" HorizontalAlignment="Center" Margin="0,18,0,0" />
      </StackPanel>

      <!-- 2. installing -->
      <StackPanel x:Name="Installing" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,30">
        <TextBlock Text="Installing Pivot Mail…" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
        <TextBlock x:Name="Step" Text="Getting ready…" FontSize="16" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" Margin="0,10,0,34" />
        <Grid Width="480">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="58" />
          </Grid.ColumnDefinitions>
          <Border x:Name="Track" Height="9" CornerRadius="4.5" Background="#E3E8EF" VerticalAlignment="Center">
            <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="4.5">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#2B323C" Offset="0" />
                  <GradientStop Color="#151A21" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Border>
          <TextBlock x:Name="Pct" Grid.Column="1" Text="0%" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <!-- 3. ready -->
      <StackPanel x:Name="Ready" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8">
        <Grid Width="62" Height="62" HorizontalAlignment="Center" Margin="0,0,0,12">
          <Ellipse Fill="#E1F5E8"><Ellipse.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.12" /></Ellipse.Effect></Ellipse>
          <Path x:Name="Tick" Data="M 19 32 L 27 40 L 43 23" Stroke="#1C9A4C" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Grid>
        <TextBlock Text="Pivot Mail is ready!" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
        <TextBlock Text="Installation completed successfully." FontSize="15" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" Margin="0,4,0,16" />
        <Border CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#B3FFFFFF" Padding="24,10" HorizontalAlignment="Center" MinWidth="340">
          <StackPanel>
            <CheckBox x:Name="RunNow" Style="{StaticResource Tick}" Content="Run Pivot Mail now" />
            <CheckBox x:Name="Startup" Style="{StaticResource Tick}" Content="Run at startup" />
            <CheckBox x:Name="Desktop" Style="{StaticResource Tick}" Content="Add a desktop shortcut" />
          </StackPanel>
        </Border>
        <Button x:Name="FinishBtn" Style="{StaticResource Primary}" Content="Finish" Margin="0,18,0,0" Click="OnFinish" />
      </StackPanel>

      <!-- something went wrong -->
      <StackPanel x:Name="Failed" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,12">
        <Grid Width="62" Height="62" HorizontalAlignment="Center" Margin="0,0,0,12">
          <Ellipse Fill="#FDE7E5" />
          <Path Data="M 31 18 L 31 35 M 31 43 L 31 43.5" Stroke="#C8281C" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>
        <TextBlock Text="Installation didn't finish" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
        <TextBlock x:Name="FailText" FontSize="15" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,8,0,24" />
        <Button Style="{StaticResource Primary}" Content="Try again" IsDefault="True" Click="OnRetry" />
        <Button Style="{StaticResource Secondary}" Content="Close" Margin="0,12,0,0" Click="OnClose" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
