{
  "name": "pivot-mail-desktop",
  "productName": "Pivot Mail",
  "version": "0.10.0",
  "description": "Pivot Mail for Windows",
  "author": "Pivot",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.1",
    "typescript": "~7.0.2"
  },
  "build": {
    "appId": "com.pivot.mail",
    "productName": "Pivot Mail",
    "artifactName": "PivotMail-Package-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "static/**",
      "build/icon.png",
      "build/tray.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json"
    ],
    "asarUnpack": [
      "dist/store-worker.js",
      "dist/store.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "minh44j",
        "repo": "Pivot-Mail",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Pivot Mail",
        "schemes": [
          "pivotmail"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "PivotMail-${version}-mac.${ext}",
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "dmg": {
      "title": "Pivot Mail",
      "writeUpdateInfo": false,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh",
      "createStartMenuShortcut": true,
      "shortcutName": "Pivot Mail"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
